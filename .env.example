# Copie para .env (ou defina no painel da hospedagem). Sem segredos reais neste arquivo.
PORT=2567
HOST=0.0.0.0
# Origens permitidas para o WebSocket, separadas por vírgula. Vazio = qualquer (só desenvolvimento).
ALLOWED_ORIGINS=
# Bots preenchem salas públicas até este total (0 desliga).
BOT_FILL=8
# facil | normal | dificil
BOT_DIFFICULTY=normal
MAX_ROOMS=50
LOG_LEVEL=info
# 1 quando atrás de proxy reverso (usa X-Forwarded-For para limite por IP)
TRUST_PROXY=0
# Etapa futura (contas/estatísticas permanentes). Ainda não usado.
DATABASE_URL=

# ---------------- Loja (aparências por R$ 1,00) ----------------
# Endereço público do jogo, com https e sem barra no final. Necessário para os pagamentos.
PUBLIC_URL=
# Banco PostgreSQL para guardar contas e compras (Render/Neon fornecem a URL).
# Sem ele, os dados ficam em arquivo e podem ser perdidos a cada novo deploy.
# DATABASE_URL=   (já listado acima)
DATA_DIR=./data
# Mercado Pago (Checkout Pro: cartão de crédito, débito e Pix).
# Painel do Mercado Pago > Suas integrações > Credenciais de produção > Access Token
MP_ACCESS_TOKEN=
# Painel > Webhooks > Assinatura secreta (para conferir os avisos de pagamento)
MP_WEBHOOK_SECRET=
# mercadopago | fake (teste local sem dinheiro de verdade) | off
PAYMENTS_MODE=
# Conteúdo do assetlinks.json gerado pelo PWABuilder (app Android). Opcional.
ASSETLINKS_JSON=

# Aviso no celular quando um jogador entra (app ntfy): https://ntfy.sh/<tópico-secreto>
NOTIFY_URL=
# Intervalo mínimo entre avisos, em segundos
NOTIFY_MIN_GAP_SEC=120
